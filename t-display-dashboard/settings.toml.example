# Copy this file to the board as settings.toml and fill in your own values.
# Most of the optional settings below can also be changed from http://<board-ip>:8080/settings;
# changes made there are saved on the board and take priority over this file.
# NEVER commit your real settings.toml: it holds your Wi-Fi password and API secrets.
# All values are strings in quotes.

# --- Wi-Fi and web workflow (CircuitPython) ---
CIRCUITPY_WIFI_SSID = "your-wifi-name"
CIRCUITPY_WIFI_PASSWORD = "your-wifi-password"
CIRCUITPY_WEB_API_PASSWORD = "pick-a-separate-password"   # for http://<board-ip>/code/
CIRCUITPY_WEB_API_PORT = 80

# --- Weather (Open-Meteo, no key needed) ---
WEATHER_TOWN = "Bijnor"
WEATHER_LAT = "29.37"
WEATHER_LON = "78.13"

# --- Zerodha portfolio (Kite Connect Personal, free) ---
KITE_API_KEY = ""
KITE_API_SECRET = ""
# KITE_EVERY = "5"            # seconds between refreshes while Portfolio or My stocks is up in market hours
# STOCK_PICKS = "RELIANCE,M&M,NIFTY25NOV24000CE:NRML"   # My stocks: holdings, and positions as SYMBOL:PRODUCT
#                             # (easier: pick them at /stocks)

# --- Markets screen (US indices; free key from financialmodelingprep.com) ---
FMP_API_KEY = ""

# --- Cricket ---
# CRICKET_SOURCE = "rss"      # "rss" = ESPNcricinfo feed (default, no key) or "cricapi"
# CRICKET_API_KEY = ""        # only for CRICKET_SOURCE = "cricapi" (cricketdata.org)
# CRICKET_TEAM = "India"      # auto-pick this team's live match
# CRICKET_EVERY = "30"

# --- News ---
# NEWS_FEED = ""              # any RSS feed; default is Google News India top stories
# NEWS_COUNT = "10"           # top headlines to cycle through (max 15)
# NEWS_SECONDS = "6"          # seconds per headline
# NEWS_PER_VISIT = "10"       # headlines shown before auto-rotate moves on

# --- Look ---
# THEME = "aura"              # "aura" (default, a style per screen) or "classic" (original grey)
#                             # the board's web page /theme can switch it too

# --- Screens and rotation ---
# SCREEN_ORDER = "weather,todo,portfolio,stocks,heatmap,markets,cricket,stat,news,trivia,net,pet"
#                             # also available: clock, matrix, fire, stars
# SCREEN_SECONDS = "15"
# AUTO_ROTATE = "off"         # screens then change only with the KEY button

# --- Reliability ---
# WATCHDOG = "off"            # disable the 2-minute hang watchdog (e.g. while using the REPL)

# --- Extra screens ---
# NIGHT_SCREEN = "clock"      # or "matrix", "fire", "stars", "cycle" (a different one each hour)
# STAT_PLAYERS = "253802:Virat Kohli,34102:Rohit Sharma,625383:Jasprit Bumrah:bowl,1070173:Shubman Gill"
# STAT_CLASS = "11"           # 11 all internationals, 1 Tests, 2 ODIs, 3 T20Is
# TRIVIA_SECONDS = "30"
# TRIVIA_SOURCE = "india"     # questions from trivia_india.txt; "world" = Open Trivia DB, "mix" = both
# TRIVIA_CATEGORY = ""        # only for "world"/"mix": 9 general, 17 science, 21 sports, 23 history
# PET_NAME = "Sheru"
# PING_HOST = "1.1.1.1"

# --- Night mode ---
# NIGHT_HOURS = "23-7"        # "" turns night mode off
# DAY_BRIGHTNESS = "0.6"
# NIGHT_BRIGHTNESS = "0.05"
